# Gradle and IDE state
.gradle/
build/
out/
.idea/
*.iml
.classpath
.project
.settings/

# Minecraft development runs
/run/
logs/
crash-reports/

# Personal client options persisted across Gradle development launches
/.dev-client-settings/

# Local integration-test add-ons (never redistributed)
/dev-addons/

# Local modpack instance state and downloaded binaries
modpack/run/*
!modpack/run/.gitkeep
!modpack/run/mods/
modpack/run/mods/*
!modpack/run/mods/.gitkeep
*.jar
!gradle/wrapper/gradle-wrapper.jar

# OS and editor files
.DS_Store
Thumbs.db
*.swp
*.swo
.env
.env.*
!.env.example
!**/.env.example

# Web workspace and Vercel state
node_modules/
.pnpm-store/
.next/
apps/web/.next/
apps/web/out/
packages/*/dist/
.vercel/
coverage/
playwright-report/
test-results/
*.tsbuildinfo

# Local Supabase state and private data operations
supabase/.temp/
supabase/.branches/
/.private/

# Private planning workbooks are imported by path and never tracked.
*.xlsx
*.xlsm
*.xlsb
*.ods
